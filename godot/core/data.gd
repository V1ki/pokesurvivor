class_name Data
extends RefCounted
## Static game data loaded once from res://data/*.json (generated by tools/export_godot.js).
## A static class (not an autoload node) so it also works in `--script` runs and headless tests.
## JSON numbers are floats and object keys are strings: lookups below are re-keyed to int where useful.

static var loaded := false

static var dex: Array = []                 # G.DEX entries (Dictionary), "dex" converted to int
static var dex_by: Dictionary = {}         # int -> entry
static var meta_by: Dictionary = {}        # int -> sprite meta (G.SPRITE_META)

static var moves: Array = []               # post melee-transform base defs
static var move_by: Dictionary = {}        # id -> def
static var ladders: Dictionary = {}        # kind -> [{t, m}]
static var evo: Dictionary = {}            # id -> [newName, needs]
static var evo_mods: Dictionary = {}       # kind -> {t, m}
static var need_name: Dictionary = {}
static var start_by_type: Dictionary = {}
static var mult_keys: Array = []
static var add_keys: Array = []
static var pool_by_type: Dictionary = {}
static var move_vfx: Dictionary = {}       # id -> G.VFX.forMove result {pal, proj, ...}

static var type_chart: Dictionary = {}
static var type_color: Dictionary = {}     # type -> Color
static var type_hex: Dictionary = {}       # type -> "#rrggbb"
static var type_name: Dictionary = {}      # type -> Spanish name
static var type_order: Array = []

static var starter_by: Dictionary = {}     # int -> {dex, start, traits}
static var enemies: Dictionary = {}        # tiers, boss_slots, late_from, heal, shield, bomb, summon, behavior_by_dex, ...
static var levelup_stats: Array = []
static var biomes: Array = []
static var vfx_pal: Dictionary = {}        # palette name -> [5 Colors]
static var icons: Dictionary = {}
static var test_vectors: Dictionary = {}

static func ensure() -> void:
	if loaded:
		return
	loaded = true
	dex = _json("pokedex.json")
	for p in dex:
		p["dex"] = int(p["dex"])
		dex_by[p["dex"]] = p
	var sm: Dictionary = _json("sprite_meta.json")
	for k in sm:
		meta_by[int(k)] = sm[k]

	var mv: Dictionary = _json("moves.json")
	moves = mv["moves"]
	for m in moves:
		move_by[m["id"]] = m
	ladders = mv["ladders"]
	evo = mv["evo"]
	evo_mods = mv["evo_mods"]
	need_name = mv["need_name"]
	start_by_type = mv["start_by_type"]
	mult_keys = mv["mult_keys"]
	add_keys = mv["add_keys"]
	pool_by_type = mv["pool_by_type"]
	move_vfx = mv["vfx"]

	var ty: Dictionary = _json("types.json")
	type_chart = ty["chart"]
	type_name = ty["name_es"]
	type_order = ty["order"]
	for t in ty["color"]:
		type_hex[t] = ty["color"][t]
		type_color[t] = Color.html(ty["color"][t])

	var st: Dictionary = _json("starters.json")
	for s in st["starters"]:
		starter_by[int(s["dex"])] = s

	enemies = _json("enemies.json")
	levelup_stats = _json("levelup_stats.json")
	var w: Dictionary = _json("world.json")
	biomes = w["biomes"]
	var vf: Dictionary = _json("vfx.json")
	for k in vf["pal"]:
		var arr: Array = []
		for h in vf["pal"][k]:
			arr.append(Color.html(h))
		vfx_pal[k] = arr
	icons = _json("icons.json")
	if FileAccess.file_exists("res://data/test_vectors.json"):
		test_vectors = _json("test_vectors.json")

static func _json(file: String) -> Variant:
	var path := "res://data/" + file
	var txt := FileAccess.get_file_as_string(path)
	if txt.is_empty():
		push_error("Data: cannot read " + path + " (run: node tools/export_godot.js)")
		return {}
	var v: Variant = JSON.parse_string(txt)
	if v == null:
		push_error("Data: invalid JSON in " + path)
		return {}
	return v

static func tcolor(t: String) -> Color:
	return type_color.get(t, Color.html("#b0a99f"))

static func pal(name: String) -> Array:
	return vfx_pal.get(name, vfx_pal.get("normal", [Color.BLACK, Color.DIM_GRAY, Color.GRAY, Color.LIGHT_GRAY, Color.WHITE]))
