class_name VFX
extends RefCounted
## Pixel-art attack sprites (port of js/entities/vfx.js). The 23 shapes come from
## data/vfx.json as palette-letter grids (o d m l w L) generated by the unchanged JS
## generator; each shape|palette|frame is turned into a tiny ImageTexture on first use.
##   VFX.draw(ci, shape, pal, x, y, angle, scale, frame, alpha)   centred on (x, y)
##   VFX.for_move(m) / VFX.for_type(t)                             look of a move / enemy shot

const IDX := {"o": 0, "d": 1, "m": 2, "l": 3, "w": 4}

static var _shapes: Dictionary = {}       # name -> {w, h, dir, spin, frames: [[rows]]}
static var _type_shape: Dictionary = {}
static var _cache: Dictionary = {}        # shape -> {pal -> [ImageTexture or null per frame]}

static func _ensure() -> void:
	if not _shapes.is_empty():
		return
	Data.ensure()
	var v: Dictionary = Data._json("vfx.json")
	_shapes = v.get("shapes", {})
	_type_shape = v.get("type_shape", {})

static func shape_def(shape: String) -> Dictionary:
	_ensure()
	return _shapes.get(shape, _shapes.get("ball", {}))

static func is_dir(shape: String) -> bool:
	_ensure()
	return _shapes.has(shape) and bool(_shapes[shape]["dir"])

static func spins(shape: String) -> bool:
	_ensure()
	return _shapes.has(shape) and bool(_shapes[shape]["spin"])

static func frames(shape: String) -> int:
	_ensure()
	return (_shapes[shape]["frames"] as Array).size() if _shapes.has(shape) else 1

## Default projectile shape of a type (enemy shots): {proj, pal}.
static func for_type(type: String) -> Dictionary:
	_ensure()
	return {"proj": _type_shape.get(type, "ball"), "pal": type if Data.vfx_pal.has(type) else "normal"}

## How a move looks: {pal, proj, beam?, melee?, aura?, buff?, trail?, inward?, rise?} (exported per move).
static func for_move(m: Dictionary) -> Dictionary:
	var v: Dictionary = Data.move_vfx.get(m.get("id", ""), {})
	if v.is_empty():
		_ensure()
		var t: String = m.get("type", "normal")
		return {"pal": t, "proj": _type_shape.get(t, "ball")}
	return v

static func tex(shape: String, pal: String, frame := 0) -> ImageTexture:
	_ensure()
	var sname := shape if _shapes.has(shape) else "ball"
	var S: Dictionary = _shapes[sname]
	var fr: Array = S["frames"]
	var f := posmod(frame, fr.size())
	# nested cache: no key string built per call (projectiles / FX sprites ask every frame)
	var bp: Variant = _cache.get(sname)
	if bp == null:
		bp = {}
		_cache[sname] = bp
	var by_pal: Dictionary = bp
	var sl: Variant = by_pal.get(pal)
	if sl == null:
		sl = []
		(sl as Array).resize(fr.size())
		by_pal[pal] = sl
	var slot: Array = sl
	var t: ImageTexture = slot[f]
	if t != null:
		return t
	var w := int(S["w"])
	var h := int(S["h"])
	var colors := Data.pal(pal)
	var light_half: Color = Color(colors[3], 0.5)
	var img := Image.create_empty(w, h, false, Image.FORMAT_RGBA8)
	var rows: Array = fr[f]
	for y in h:
		var row: String = rows[y]
		for x in w:
			var ch := row[x]
			if ch == ".":
				continue
			img.set_pixel(x, y, light_half if ch == "L" else colors[IDX.get(ch, 2)])
	t = ImageTexture.create_from_image(img)
	slot[f] = t
	return t

## Centred on (x, y); angle snapped to 16 directions; scale 1 = one game pixel (PX wu).
## snap_angle=false keeps the exact angle (sprites inside a rotated beam).
static func draw(ci: CanvasItem, shape: String, pal: String, x: float, y: float, angle := 0.0, scale := 1.0,
		frame := 0, alpha := 1.0, snap_angle := true) -> void:
	if alpha <= 0.0:
		return
	var S := shape_def(shape)
	if S.is_empty():
		return
	var t := tex(shape, pal, frame)
	var k := Sprites.PX * scale
	var w := float(S["w"]) * k
	var h := float(S["h"]) * k
	var a := angle
	if angle != 0.0 and snap_angle:
		a = roundf(angle / (PI / 8.0)) * (PI / 8.0)      # 16 directions: less flicker
	ci.draw_set_transform(Vector2(U.jround(x), U.jround(y)), a, Vector2.ONE)
	ci.draw_texture_rect(t, Rect2(-w / 2.0, -h / 2.0, w, h), false, Color(1, 1, 1, alpha))
	ci.draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
